from pathlib import Path

configfile: "workflow/config/chromecrispr.yaml"

REPORTS_DIR = config["reports_dir"]
REGISTRY_JSON = f"{REPORTS_DIR}/model_registry.json"
REGISTRY_MD = f"{REPORTS_DIR}/model_registry.md"
INTEGRITY_JSON = f"{REPORTS_DIR}/repo_integrity.json"
INTEGRITY_MD = f"{REPORTS_DIR}/repo_integrity.md"
AUDIT_JSON = f"{REPORTS_DIR}/public_examples_audit.json"
AUDIT_MD = f"{REPORTS_DIR}/public_examples_audit.md"
SUMMARY_MD = f"{REPORTS_DIR}/public_repo_summary.md"
FULL_SUMMARY_MD = f"{REPORTS_DIR}/public_repo_full_summary.md"

CANONICAL_MODEL_INPUTS = sorted(str(path) for path in Path("models").glob("**/*") if path.is_file())
HYPERPARAMETER_INPUTS = sorted(str(path) for path in Path("docs/hyperparameters").glob("*_hyperparameters.json"))
PUBLIC_DOC_INPUTS = config["docs_to_audit"]
WORKFLOW_SOURCE_INPUTS = sorted(str(path) for path in Path("workflow").glob("**/*") if path.is_file())
SOURCE_CODE_INPUTS = sorted(
    str(path)
    for path in Path("src").glob("**/*")
    if path.is_file() and path.suffix in {".py", ".md"}
)
SCRIPT_INPUTS = sorted(str(path) for path in Path("scripts").glob("*.py")) + ["scripts/run_snakemake.sh"]

include: "rules/preprocessing.smk"
include: "rules/smoke.smk"
include: "rules/reporting.smk"
include: "rules/integrity.smk"
include: "rules/audit.smk"

rule all:
    input:
        REGISTRY_JSON,
        REGISTRY_MD,
        INTEGRITY_JSON,
        INTEGRITY_MD,
        AUDIT_JSON,
        AUDIT_MD,
        PREPROCESSING_JSON,
        PREPROCESSING_MD,
        SUMMARY_MD

rule inventory:
    input:
        REGISTRY_JSON,
        REGISTRY_MD

rule integrity:
    input:
        INTEGRITY_JSON,
        INTEGRITY_MD

rule audit:
    input:
        AUDIT_JSON,
        AUDIT_MD

rule preprocessing:
    input:
        PREPROCESSING_JSON,
        PREPROCESSING_MD

rule smoke:
    input:
        SMOKE_JSON,
        SMOKE_MD,
        VALIDATOR_JSON

rule report:
    input:
        SUMMARY_MD,
        PREPROCESSING_MD

rule full:
    input:
        FULL_SUMMARY_MD,
        PREPROCESSING_MD,
        SMOKE_MD,
        VALIDATOR_JSON
